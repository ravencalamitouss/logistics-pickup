{
  "info": {
    "name": "logistics-pickup API Tests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "GET / - Service Info",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function() {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('Service name is correct', function() {",
              "  const json = pm.response.json();",
              "  pm.expect(json.service).to.eql('logistics-pickup');",
              "});",
              "pm.test('Status is running', function() {",
              "  const json = pm.response.json();",
              "  pm.expect(json.status).to.eql('running');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "GET /health - Health Check",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function() {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('Health status is ok', function() {",
              "  const json = pm.response.json();",
              "  pm.expect(json.status).to.eql('ok');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "GET /version - Version Info",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/version"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function() {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('Version field exists', function() {",
              "  const json = pm.response.json();",
              "  pm.expect(json).to.have.property('version');",
              "});",
              "pm.test('Service name is correct', function() {",
              "  const json = pm.response.json();",
              "  pm.expect(json.service).to.eql('logistics-pickup');",
              "});"
            ]
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ]
}
